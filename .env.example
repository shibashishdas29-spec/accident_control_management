# ─── AEGIS Environment Variables ────────────────────────
# Copy this to .env and fill in values

NODE_ENV=development
PORT=3000

# ─── PostgreSQL ──────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=aegis_db
PG_USER=postgres
PG_PASSWORD=your_pg_password_here

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/aegis_db

# ─── Python AI Service ───────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── CORS ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── File Storage ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500

# ─── SMS/Email Alerts (optional) ─────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
